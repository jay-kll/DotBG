# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log

# Dependency directories
node_modules/

# Environment variables
.env

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS specific
.DS_Store

# Task files
# NOTE: tasks.json was previously ignored here. README declared it the canonical
# task source, which is why it never existed in the repo. It is now tracked.
tasks/

# Godot editor cache and imports
.godot/
*.tmp
*.translation

# Godot exports and binaries
Godot_*
*.appimage
build/
export/
*.apk
*.aab
*.pck
*.exe

# Godot export credentials — never commit
export_credentials.cfg

# Generated asset candidates — disposable by design, see ASSETS.md §1
# Prompts, approved work and rejection records ARE tracked; raw candidates are not.
art/candidates/

# Golden renders awaiting a decision. The approved baselines under
# art/golden/approved/ ARE tracked — they are what drift is measured against,
# and a baseline nobody committed protects nothing.
art/golden/current/

# The unattended-run stop signal, AGENTS.md §7.3. Local control, not repo state:
# committing it would stop every clone. Run journals under runs/ ARE tracked —
# they are the audit trail of what happened while nobody was watching.
/STOP
